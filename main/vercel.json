{
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/log",
      "destination": "/log.html"
    },
    {
      "source": "/meow",
      "destination": "/meow/index.html"
    },
    {
      "source": "/pbb",
      "destination": "/pbb/index.html"
    },
    {
      "source": "/arf",
      "destination": "/arf/index.html"
    },
    {
      "source": "/student",
      "destination": "/student/index.html"
    },
    {
      "source": "/brat",
      "destination": "/brat/index.html"
    },
    {
      "source": "/brat/",
      "destination": "/brat/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/legal/privacy.html"
    },
    {
      "source": "/cookies",
      "destination": "/legal/cookies.html"
    },
    {
      "source": "/terms",
      "destination": "/legal/terms.html"
    },
    {
      "source": "/brat/style.css",
      "destination": "/brat/assets/css/style.css"
    },
    {
      "source": "/brat/script.js",
      "destination": "/brat/assets/js/script.js"
    },
    {
      "source": "/brat/enhancements.js",
      "destination": "/brat/assets/js/enhancements.js"
    },
    {
      "source": "/style.css",
      "destination": "/assets/css/home.css"
    },
    {
      "source": "/script.js",
      "destination": "/assets/js/home.js"
    },
    {
      "source": "/meow/style.css",
      "destination": "/meow/assets/style.css"
    },
    {
      "source": "/meow/script.js",
      "destination": "/meow/assets/script.js"
    },
    {
      "source": "/arf/style.css",
      "destination": "/arf/assets/style.css"
    },
    {
      "source": "/arf/script.js",
      "destination": "/arf/assets/script.js"
    },
    {
      "source": "/privacy.js",
      "destination": "/assets/shared/privacy.js"
    },
    {
      "source": "/privacy.css",
      "destination": "/assets/shared/privacy.css"
    },
    {
      "source": "/legal.css",
      "destination": "/assets/shared/legal.css"
    },
    {
      "source": "/privacy.html",
      "destination": "/legal/privacy.html"
    },
    {
      "source": "/cookies.html",
      "destination": "/legal/cookies.html"
    },
    {
      "source": "/terms.html",
      "destination": "/legal/terms.html"
    }
  ],
  "headers": [
    {
      "source": "/brat",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/brat/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/brat/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/brat/:file*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/privacy.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/privacy.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
